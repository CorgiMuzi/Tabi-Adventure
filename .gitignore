# ============================================================================
#  Unreal Engine — generated / build artifacts (never committed)
# ============================================================================

# Compiled binaries and intermediates
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# User preferences
Config/DefaultEditorPerProjectUserSettings.ini

# Build records
Build/

# Plugin build artifacts (plugin source is kept; only its generated output is ignored)
Plugins/**/Binaries/
Plugins/**/Intermediate/

# IDE / project files (regenerated from .uproject)
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Linux / macOS project files (generated by GenerateProjectFiles)
Makefile
CMakeLists.txt
CMakeCache.txt
*.code-workspace
compile_commands.json
.ignore

# Rider
*.DotSettings.user
Plugins/Developer/RiderLink/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Crash / log artifacts
*.log
*.pdb

# Assets
Content/Assets/
Content/Fab/
Content/Fonts/

# Game design related
Docs/

# Daily work plans (per-date progress tracking, local only)
Plans/
